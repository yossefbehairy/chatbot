# Copy this file to ".env" and fill in your values.
# The real .env is gitignored — never commit your keys.

# AI providers
# Groq is tried first, Gemini is the automatic fallback.
GROQ_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=        # alternative name for the Gemini key

# Optional: owner number for notifications (international format, digits only)
MY_NUMBER=

# Optional: control panel port (default: 3750)
GUI_PORT=3750
